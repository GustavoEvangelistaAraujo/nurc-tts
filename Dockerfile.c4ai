ARG BASE=nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04
FROM ${BASE}

ENV DEBIAN_FRONTEND=noninteractive
ENV HOME=/root
ENV PIP_DEFAULT_TIMEOUT=1000
ENV PIP_RETRIES=10
ENV PYTHONNOUSERSITE=1

# Runtime settings
ENV COQUI_TOS_AGREED=1
ENV TRAINER_TELEMETRY=0
ENV TTS_TELEMETRY=0
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# System dependencies
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        make \
        git \
        curl \
        ca-certificates \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        python3-wheel \
        espeak-ng \
        libsndfile1-dev \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --upgrade pip setuptools wheel

# Binary dependency used by TTS stack
RUN pip3 install \
    llvmlite \
    --prefer-binary \
    --default-timeout=1000 \
    --retries=10

# Install PyTorch version compatible with older Coqui TTS sampler code.
# Do not use the latest cu126 torch here; it can break old sampler classes.
# CUDA 12.1 PyTorch wheels can run on a newer CUDA 12.x host driver.
RUN set -eux; \
    for attempt in 1 2 3 4 5; do \
        pip3 install \
            torch==2.1.2 \
            torchaudio==2.1.2 \
            --index-url https://download.pytorch.org/whl/cu121 \
            --default-timeout=1000 \
            --retries=10 \
            --prefer-binary && break; \
        echo "PyTorch install failed. Retry ${attempt}/5..."; \
        sleep 60; \
    done; \
    python3 - <<'PY'
import torch
print("torch:", torch.__version__)
print("torch compiled CUDA:", torch.version.cuda)
assert torch.__version__.startswith("2.1.2"), f"Expected torch 2.1.2, got {torch.__version__}"
assert torch.version.cuda == "12.1", f"Expected CUDA 12.1 torch build, got {torch.version.cuda}"
assert torch.version.cuda is not None, "Installed torch has no CUDA support"
PY

# Freeze torch versions so later pip installs do not upgrade torch/torchaudio.
RUN pip3 freeze | grep -E '^(torch|torchaudio)==' > /tmp/torch-constraints.txt && \
    cat /tmp/torch-constraints.txt

WORKDIR /opt/TTS
COPY . /opt/TTS

RUN chmod -R a+rX /opt/TTS

# Dataset/runtime dependencies
RUN pip3 install \
        datasets==2.19.2 \
        dill==0.3.8 \
        multiprocess==0.70.16 \
        pyarrow \
        pyarrow-hotfix \
        xxhash \
        soundfile \
        tqdm==4.64.1 \
        --constraint /tmp/torch-constraints.txt \
        --default-timeout=1000 \
        --retries=10 \
        --prefer-binary

# Install local TTS package without allowing torch to be upgraded.
RUN pip3 install . \
        --constraint /tmp/torch-constraints.txt \
        --default-timeout=1000 \
        --retries=10 \
        --prefer-binary

# Final safety check: fail build if torch was changed by dependency resolution.
RUN python3 - <<'PY'
import sys
from pathlib import Path
import torch
import TTS

print("python:", sys.version)
print("torch:", torch.__version__)
print("torch compiled CUDA:", torch.version.cuda)
print("cuda available:", torch.cuda.is_available())
print("TTS package:", getattr(TTS, "__version__", "unknown"))
print("TTS path:", Path(TTS.__file__).resolve())

assert torch.__version__.startswith("2.1.2"), f"Expected torch 2.1.2, got {torch.__version__}"
assert torch.version.cuda == "12.1", f"Expected torch CUDA 12.1 build, got {torch.version.cuda}"
assert "+cu130" not in torch.__version__, f"Wrong torch build: {torch.__version__}"
PY

RUN rm -rf /root/.cache/pip

WORKDIR /workspace

ENTRYPOINT ["tts"]
CMD ["--help"]